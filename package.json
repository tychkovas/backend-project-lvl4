   "version": "0.1.0",
   "type": "module",
   "description": "task manager",
   "main": "server/index.js",
   "scripts": {
      "test": "jest --verbose --runInBand",
      "prebuild": "rm -rf dist",
      "build": "webpack",
      "start": "node server/bin/server.js"
