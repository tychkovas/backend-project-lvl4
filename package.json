      "eslint-plugin-jest": "^28.14.0",
      "globals": "^17.13.0",
      "jest": "^30.5.2",
      "jest-cli": "^30.5.2",
      "nodemon": "^2.0.15",
      "style-loader": "^3.3.1",
      "webpack-cli": "^4.9.2",
      "webpack-dev-server": "^3.11.3"
   },
   "allowScripts": {
      "sodium-native@5.2.0": true
   }
