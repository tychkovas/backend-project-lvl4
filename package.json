      ],
      "setupFiles": [
         "dotenv/config"
      ]
   },
   "author": "Aleksandr Tychkov",
   "license": "ISC",
   "repository": {
      "type": "git",
      "url": "git+https://github.com/tychkovas/backend-project-lvl4.git"
   },
   "bugs": {
      "url": "https://github.com/tychkovas/backend-project-lvl4/issues"
   },
   "homepage": "https://github.com/tychkovas/backend-project-lvl4#readme",
   "dependencies": {
      "@fastify/cookie": "^11.1.5",
      "@fastify/flash": "^6.0.6",
      "@fastify/formbody": "^9.0.1",
      "@fastify/passport": "^4.0.4",
      "@fastify/secure-session": "^8.4.1",
      "@fastify/sensible": "^6.0.7",
      "@fastify/static": "^10.1.8",
      "@fastify/view": "^11.1.1",
      "better-sqlite3": "^12.2.0",
      "bootstrap": "^5.1.3",
      "dotenv": "^16.0.0",
      "fastify": "^5.12.7",
      "fastify-plugin": "^5.1.0",
      "i18next": "^21.6.16",
      "jquery": "^3.6.0",
      "knex": "^3.1.0",
      "lodash": "^4.17.21",
      "mini-css-extract-plugin": "^2.6.0",
      "objection": "^3.0.1",
      "objection-unique": "^1.2.2",
      "pg": "^8.7.3",
      "pino-pretty": "^7.6.1",
      "pug": "^3.0.2",
      "qs": "^6.10.3",
      "rollbar": "^2.25.0",
      "webpack": "^5.72.0"
   },
   "devDependencies": {
      "@eslint/compat": "^2.1.1",
      "@eslint/js": "^9.39.5",
      "@faker-js/faker": "^6.2.0",
      "@jest/globals": "^30.5.2",
