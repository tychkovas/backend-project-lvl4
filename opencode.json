{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "allow" }
  ],
  "mcp": {
    "servers": {
      "render": {
        "type": "remote",
        "url": "https://mcp.render.com/mcp",
        "oauth": false,
        "disabled": false,
        "headers": {
          "Authorization": "Bearer {env:RENDER_API_KEY}"
        }
      }
    }
  }
}
