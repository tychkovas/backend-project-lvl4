extends ../layouts/application.pug

block header
  = t('views.users.heading')

block content
  table.table.table-striped.table-dark
    thead
      tr
        th= t('views.users.id')
        th= t('views.users.fullName')
        th= t('views.users.email')
        th= t('views.users.createdAt')
        th
    tbody
      each user in users
        tr
          td= user.id
          td= user.fullName()
          td= user.email
          td= formatDate(user.createdAt)
          td
            .d-flex.flex-wrap.gap-2.justify-content-center
              a.btn.btn-sm.btn-outline-light(href=route('openForEditUser', { id: user.id }))= t('views.users.actions.edit')
              form.d-inline(action=route('deleteUser', { id: user.id }), method='post')
                input(name='_method', type='hidden', value='delete')
                input.btn.btn-sm.btn-outline-danger(type='submit', value= t('views.users.actions.delete'))
