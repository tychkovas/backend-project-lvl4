extends ../layouts/application.pug

block header
  = t('views.labels.heading')

block content
  .mb-3
    a.btn.btn-primary(href=route('newLabel'))= t('views.labels.actions.new')
  table.table.table-striped.table-dark
    thead
      tr
        th= t('views.labels.id')
        th= t('views.labels.name')
        th= t('views.labels.createdAt')
        th
    tbody
      each label in labels
        tr
          td= label.id
          td= label.name
          td= formatDate(label.createdAt)
          td
            .d-flex.flex-wrap.gap-2.justify-content-center
              a.btn.btn-sm.btn-outline-light(href=route('openForEditLabel', { id: label.id}))= t('views.labels.actions.edit')
              form.d-inline(action=route('deleteLabel', { id: label.id}), method='post')
                input(name='_method', type='hidden', value='delete')
                input.btn.btn-sm.btn-outline-danger(type='submit', value= t('views.labels.actions.delete'))
